apiVersion: apps/v1
kind: Deployment
metadata:
  name: profile-service
  namespace: movie-rec-hub
spec:
  replicas: 1
  # Keep one application instance/version during updates on this small installation.
  strategy:
    type: Recreate
  progressDeadlineSeconds: 600
  selector:
    matchLabels:
      app: profile-service
  template:
    metadata:
      labels:
        app: profile-service
      annotations:
        checksum/config: "{{ application_config_checksum }}"
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: profile-service
          image: "{{ registry_image_prefix }}/profile-service:{{ application_image_tag }}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8082
          envFrom:
            - configMapRef:
                name: application-common
            - configMapRef:
                name: profile-service-config
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
---
apiVersion: v1
kind: Service
metadata:
  name: profile-service
  namespace: movie-rec-hub
spec:
  type: ClusterIP
  selector:
    app: profile-service
  ports:
    - name: http
      port: 8082
      targetPort: http
