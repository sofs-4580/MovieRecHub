apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: auth-provider-gcp
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    matchImages:
      - "{{ registry_image_prefix }}/"
    args: [get-credentials]
    defaultCacheDuration: 1m
    env:
      - name: KUBE_SIDECAR_CACHE_DURATION
        value: "1m"
      - name: KUBE_SIDECAR_CACHE_TYPE
        value: "registry"
      # Metadata is local to the VM; never send it through a HTTP proxy.
      - name: NO_PROXY
        value: "metadata.google.internal,metadata.google.internal.,169.254.169.254"
